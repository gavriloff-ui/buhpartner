# Скопируйте этот файл в server/.env и заполните.
# Файл server/.env НЕ коммитится (см. .gitignore) — в нём секреты.

# Токен бота MAX: платформа MAX для партнёров → Чат-боты → Настройки → Токен
MAX_BOT_TOKEN=

# ID вашего диалога с ботом. Получается скриптом:  node server/get-chat-id.js
# (нужно один раз нажать «Начать» боту в MAX)
MAX_CHAT_ID=

# Порт HTTP-сервера (для Yandex Cloud Functions задаётся платформой)
PORT=8080

# Разрешённые источники (CORS), через запятую
ALLOWED_ORIGINS=https://buhpartner.ru,https://www.buhpartner.ru

# Необязательно: общий секрет, клиент шлёт его заголовком X-Lead-Secret
LEAD_SECRET=

# Анти-спам: максимум заявок с одного IP за окно (по умолчанию 10 за 10 минут)
RATE_LIMIT=10
RATE_WINDOW_MS=600000
